<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Employee Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container mt-4">
    <div class="row">
      <div class="col-lg-8 mx-auto text-center">
        <h1 class="display-4 fw-bold text-primary mb-3">Employee Management System</h1>
        <p class="lead text-muted mb-4">Manage your workforce efficiently with our comprehensive platform.</p>
        <a href="/dashboard" class="btn btn-primary btn-lg me-2"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="/employees" class="btn btn-outline-primary btn-lg"><i class="bi bi-people"></i> View Employees</a>
      </div>
    </div>
    <div class="row g-4 mt-5">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center p-4">
          <i class="bi bi-people-fill text-primary display-3"></i>
          <h4 class="mt-3">Employee Management</h4>
          <p class="text-muted">Add, edit, view, and delete employee records with ease.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center p-4">
          <i class="bi bi-building text-success display-3"></i>
          <h4 class="mt-3">Departments</h4>
          <p class="text-muted">Organize employees by departments and track headcount.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center p-4">
          <i class="bi bi-folder text-warning display-3"></i>
          <h4 class="mt-3">Projects</h4>
          <p class="text-muted">Track project status, budgets, and team allocations.</p>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>