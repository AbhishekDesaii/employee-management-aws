<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Employee Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-people"></i> Employees</h1>
      <a href="/employees/add" class="btn btn-success"><i class="bi bi-plus-circle"></i> Add Employee</a>
    </div>
    <% if (locals.error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-primary">
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Salary</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (employees && employees.length > 0) { %>
                <% employees.forEach(function(emp) { %>
                  <tr>
                    <td><%= emp.id %></td>
                    <td><%= emp.name %></td>
                    <td><%= emp.email %></td>
                    <td><%= emp.phone %></td>
                    <td><span class="badge bg-info"><%= emp.department %></span></td>
                    <td><%= emp.designation %></td>
                    <td>$<%= emp.salary.toLocaleString() %></td>
                    <td>
                      <a href="/employees/edit/<%= emp.id %>" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                      <button class="btn btn-sm btn-danger delete-emp" data-id="<%= emp.id %>"><i class="bi bi-trash"></i></button>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="8" class="text-center text-muted py-4">No employees found</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
  <script>
    document.querySelectorAll('.delete-emp').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (confirm('Delete this employee?')) {
          var id = this.getAttribute('data-id');
          fetch(API_BASE_URL + '/api/employees/' + id, { method: 'DELETE' })
            .then(function(r) { return r.json(); })
            .then(function() { location.reload(); })
            .catch(function(err) { alert('Delete failed'); });
        }
      });
    });
  </script>
</body>
</html>