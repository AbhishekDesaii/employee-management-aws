<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Employee Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h1>

    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-primary">
          <div class="card-body text-center">
            <i class="bi bi-people display-4"></i>
            <h5 class="card-title mt-2">Employees</h5>
            <h2 class="mb-0"><%= stats.total_employees %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-success">
          <div class="card-body text-center">
            <i class="bi bi-building display-4"></i>
            <h5 class="card-title mt-2">Departments</h5>
            <h2 class="mb-0"><%= stats.total_departments %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-warning">
          <div class="card-body text-center">
            <i class="bi bi-folder display-4"></i>
            <h5 class="card-title mt-2">Projects</h5>
            <h2 class="mb-0"><%= stats.total_projects %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-info">
          <div class="card-body text-center">
            <i class="bi bi-currency-dollar display-4"></i>
            <h5 class="card-title mt-2">Avg Salary</h5>
            <h2 class="mb-0">$<%= stats.avg_salary.toLocaleString() %></h2>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white fw-bold">Recent Employees</div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr><th>Name</th><th>Department</th><th>Designation</th><th>Salary</th></tr>
                </thead>
                <tbody>
                  <% if (employees && employees.length > 0) { %>
                    <% employees.slice(0, 5).forEach(function(emp) { %>
                      <tr>
                        <td><%= emp.name %></td>
                        <td><%= emp.department %></td>
                        <td><%= emp.designation %></td>
                        <td>$<%= emp.salary.toLocaleString() %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr><td colspan="4" class="text-center text-muted">No employees found</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white fw-bold">Projects Overview</div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr><th>Project</th><th>Status</th><th>Team</th><th>Budget</th></tr>
                </thead>
                <tbody>
                  <% if (projects && projects.length > 0) { %>
                    <% projects.forEach(function(proj) { %>
                      <tr>
                        <td><%= proj.name %></td>
                        <td><span class="badge bg-<%= proj.status === 'Completed' ? 'success' : proj.status === 'In Progress' ? 'primary' : proj.status === 'Planning' ? 'warning' : 'secondary' %>"><%= proj.status %></span></td>
                        <td><%= proj.team_size %></td>
                        <td>$<%= proj.budget.toLocaleString() %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr><td colspan="4" class="text-center text-muted">No projects found</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>