<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Employee Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container mt-4">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <h1 class="mb-4"><i class="bi bi-info-circle"></i> About</h1>
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <h4>Employee Management System</h4>
            <p class="text-muted">Version 1.0.0</p>
            <hr>
            <h5>Tech Stack</h5>
            <ul>
              <li><strong>Backend:</strong> Python 3.12, Flask, Gunicorn</li>
              <li><strong>Frontend:</strong> Node.js 22, Express.js, EJS, Bootstrap 5</li>
              <li><strong>Infrastructure:</strong> Docker, Nginx, AWS</li>
            </ul>
            <hr>
            <h5>API Endpoints</h5>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead><tr><th>Method</th><th>Endpoint</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td>GET</td><td>/api/health</td><td>Health check</td></tr>
                  <tr><td>GET</td><td>/api/employees</td><td>List employees</td></tr>
                  <tr><td>POST</td><td>/api/employees</td><td>Create employee</td></tr>
                  <tr><td>PUT</td><td>/api/employees/:id</td><td>Update employee</td></tr>
                  <tr><td>DELETE</td><td>/api/employees/:id</td><td>Delete employee</td></tr>
                  <tr><td>GET</td><td>/api/departments</td><td>List departments</td></tr>
                  <tr><td>GET</td><td>/api/projects</td><td>List projects</td></tr>
                  <tr><td>GET</td><td>/api/stats</td><td>Dashboard stats</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>